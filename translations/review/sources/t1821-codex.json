  "lines": {
    "T41n1821_p0074b26": "事業義。」「作意謂能令",
    "T41n1821_p0074b27": "心警覺」者，作動於意故名作意。謂能令心",
    "T41n1821_p0074b28": "警覺前境，心如睡眠沈沒不行，由作意力",
    "T41n1821_p0074b29": "警覺取境。理實亦能警覺心所，從強說心。"
  }
}
